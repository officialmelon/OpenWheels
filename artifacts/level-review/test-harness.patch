@@ -48,11 +52,126 @@ int runWorldDump(const std::string& outPath, const std::string& levelPath, int f
     }
     auto replay = new ReplayData();
     int state = 0;
+    std::vector<unsigned char> base0;
     for (int f = 0; f < frames + 8; ++f) {
         for (auto& c : changes)
             if (c.first == f) state = c.second;
         replay->addEntry((unsigned char)state);
