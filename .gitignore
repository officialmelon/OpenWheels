# Binary reference material (Fancy Force copyrighted data) — never commit
binary/
*.xapk
*.ipa

# re-agent runtime artifacts
reports/
re-agent-progress.json
re-agent-progress.json.lock
.cache/

# Build output
build/
out/
*.exe
*.o

# Engine: unpacked cocos2d-x 3.17.2 + v3-deps-158 and the downloaded zips are
# recreated by tools/fetch_engine.ps1; thirdparty/patches/ stays tracked.
thirdparty/cocos2d-x/
thirdparty/_downloads/

# local clangd flags (machine-specific NDK path)
compile_flags.txt

# extra local build trees (tools/build.ps1 -BuildDir ...)
build-*/
build_*/

# Android build (android/ Gradle project; tools/build_android.ps1)
android/.gradle/
android/.kotlin/
android/local.properties
android/app/.cxx/
*.apk
