<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon for Android 5-7 (no adaptive icons): the OpenWheels wheel on the menu blue.
     Android 8+ uses mipmap-anydpi-v26/ic_launcher.xml. Used only when the original game's res/
     folder is not available at build time. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
